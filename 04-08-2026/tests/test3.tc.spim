.text
.globl main
main:
    subu $sp, $sp, 4
    sw   $ra, 0($sp)
    subu $sp, $sp, 4
    sw   $fp, 0($sp)
    addiu $fp, $sp, -12
    move $sp, $fp
    li $t0, 5
    sw $t0, 0($fp)
    li $t0, 5
    sw $t0, 4($fp)
    lw $t0, 4($fp)
    lw $t1, 0($fp)
    mul $t2, $t0, $t1
    lw $t3, 0($fp)
    add $t4, $t3, $t2
    lw $t5, 0($fp)
    lw $t6, 0($fp)
    mul $t7, $t5, $t6
    add $t8, $t4, $t7
    sw $t8, 8($fp)
    lw $t8, 8($fp)
    move $a0, $t8
    li $v0, 1
    syscall
    addiu $sp, $fp, 12
    lw    $fp, 0($sp)
    addiu $sp, $sp, 4
    lw    $ra, 0($sp)
    addiu $sp, $sp, 4
    jr    $ra
